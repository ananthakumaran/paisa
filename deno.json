{
  "tasks": {
    "dev": "deno run -A npm:vite dev --host 0.0.0.0",
    "develop": "deno run --allow-env --allow-read --allow-run --allow-write scripts/dev.ts --frontend",
    "debug": "deno run --allow-env --allow-read --allow-run --allow-write scripts/dev.ts --frontend --now",
    "serve": "deno run --allow-env --allow-read --allow-run --allow-write scripts/dev.ts",
    "serve:now": "deno run --allow-env --allow-read --allow-run --allow-write scripts/dev.ts --now",
    "preview": "deno run -A npm:vite preview",

    "build": "deno run -A npm:vite build",
    "build:watch": "deno run -A npm:vite build --watch",

    "check": "deno task typecheck",
    "check:tooling": "deno run -A scripts/check.ts --tooling",
    "format": "deno fmt",
    "lint": "deno lint",
    "typecheck": "deno run -A scripts/check.ts",

    "parser-build": "deno run -A npm:@lezer/generator src/lib/sheet/language.grammar -o src/lib/sheet/parser && deno run -A npm:@lezer/generator src/lib/search/parser/query.grammar -o src/lib/search/parser/parser",
    "parser-build-debug": "deno run -A npm:@lezer/generator src/lib/sheet/language.grammar --names -o src/lib/sheet/parser && deno run -A npm:@lezer/generator src/lib/search/parser/query.grammar --names -o src/lib/search/parser/parser",

    "test": "deno task test:unit && deno task test:integration",
    "test:component": "deno run -A npm:vitest@2.1.9 run --config vitest.config.ts --pool=threads --maxWorkers=1 --minWorkers=1",
    "test:coverage": "deno run -A scripts/coverage.ts",
    "test:coverage:report": "deno run -A scripts/coverage.ts --report-only",
    "test:desktop": "deno run --allow-env --allow-read --allow-run --allow-write scripts/desktop_smoke.ts",
    "test:e2e": "deno run -A scripts/run_browser_tests.ts --grep-invert @visual",
    "test:frontend": "deno task test:unit && deno task test:component && deno task test:e2e && deno task test:visual && deno task test:coverage",
    "test:integration": "deno test --no-check --allow-all tests/",
    "test:unit": "deno test --no-check --allow-read --allow-env --ignore=src/lib/components src/",
    "test:visual": "deno run -A scripts/run_browser_tests.ts --grep @visual",
    "test:visual:update": "deno run -A scripts/run_browser_tests.ts --grep @visual --update-snapshots",

    "clean": "rm -rf .svelte-kit web/static paisa"
  },
  "imports": {
    "$lib": "./src/lib",
    "$lib/*": "./src/lib/*",

    "@cityssm/bulma-sticky-table": "npm:@cityssm/bulma-sticky-table@^2.1.0",
