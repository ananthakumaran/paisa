  "compilerOptions": {
    "checkJs": false,
    "skipLibCheck": true,
    "noImplicitAny": true
  },
  "fmt": {
    "exclude": [".svelte-kit/", "web/static/"]
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-explicit-any",
        "no-unused-vars",
        "prefer-const",
        "no-empty",
        "no-window",
        "no-window-prefix",
        "require-await",
        "no-var",
        "no-inner-declarations",
        "no-sloppy-imports"
      ]
    },
    "exclude": [".svelte-kit/", "web/static/"]
  },
  "unstable": ["sloppy-imports"],
  "nodeModulesDir": "auto"
