    "vite-plugin-node-polyfills": "npm:vite-plugin-node-polyfills@^0.19.0",
    "wait-port": "npm:wait-port@^1.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.19.3/xlsx-0.19.3.tgz",
    "xlsx-populate": "npm:xlsx-populate@^1.21.0",
    "$lib": "./src/lib",
    "$lib/*": "./src/lib/*"
